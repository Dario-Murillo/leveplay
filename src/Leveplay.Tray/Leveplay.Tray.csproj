<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Leveplay</AssemblyName>
    <RootNamespace>Leveplay.Tray</RootNamespace>
    <ApplicationIcon>Assets\leveplay.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\leveplay.ico" LogicalName="Leveplay.Tray.leveplay.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Leveplay.Core\Leveplay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.local.json" Condition="Exists('appsettings.local.json')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
